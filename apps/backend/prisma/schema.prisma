// Prisma schema for sync-5th-tab
// PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String   @id @default(uuid(7))
  name        String
  slug        String   @unique
  mtSubdomain String
  clientId    String
  clientSecret String?
  createdAt   DateTime @default(now())

  products    Product[]
  sessions    Session[]
  banners     Banner[]
  users       User[]
  tenantBrand TenantBrand?
  categories  Category[]
}

model Product {
  id          String   @id @default(uuid(7))
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  mtProductId String // Marianatek product ID (e.g., "14965")
  description String? // Custom description (overrides MT description)
  visible     Boolean  @default(true)
  sortOrder   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants ProductVariant[]
  images   ProductImage[]
  categories ProductCategory[]

  @@unique([tenantId, mtProductId])
  @@index([tenantId])
  @@index([mtProductId])
}

model Session {
  id           String   @id @default(uuid(7))
  userId       String
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  role         String // 'admin' or 'customer'
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
}

model Banner {
  id           String    @id @default(uuid(7))
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  filename     String // stored filename (UUID-based)
  originalName String // original upload name
  mimeType     String // image/jpeg, image/png, etc.
  size         Int // file size in bytes
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  productClass String?
  expiresAt    DateTime?
  sortOrder    Int?
  visible      Boolean   @default(true)
  createdAt    DateTime  @default(now())

  @@index([tenantId])
  @@index([visible])
  @@index([categoryId])
}

model ProductVariant {
  id          String   @id @default(uuid(7))
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  mtVariantId String // Marianatek variant ID (e.g., "14966")
  sku         String // SKU from MT (e.g., "TEST8877")
  description String? // Custom description (overrides MT description)
  visible     Boolean  @default(true)
  sortOrder   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images ProductImage[]

  @@unique([productId, mtVariantId])
  @@index([productId])
  @@index([mtVariantId])
  @@index([sku])
}

model ProductImage {
  id           String          @id @default(uuid(7))
  productId    String?
  product      Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  filename     String // stored filename (UUID-based)
  originalName String // original upload name
  mimeType     String // image/jpeg, image/png, etc.
  size         Int // file size in bytes
  isFeatured   Boolean         @default(false) // featured image flag
  sortOrder    Int             @default(0) // for gallery ordering
  createdAt    DateTime        @default(now())

  @@index([productId])
  @@index([variantId])
  @@index([isFeatured])
}

model User {
  id                  String   @id
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  email               String?
  name                String?
  role                String
  preferredLocationId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId])
  @@index([role])
}

model TenantBrand {
  id                    String   @id @default(uuid())
  tenantId              String   @unique
  tenant                Tenant   @relation(fields: [tenantId], references: [id])
  brandName             String?
  primaryColor          String?
  primaryForegroundColor String?
  secondaryColor        String?
  secondaryForegroundColor String?
  logoLightUrl          String?
  logoDarkUrl           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Category {
  id          String   @id @default(uuid(7))
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  slug        String
  imageUrl    String?
  sortOrder   Int?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    ProductCategory[]
  banners     Banner[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([sortOrder])
  @@index([deletedAt])
}

model ProductCategory {
  id          String   @id @default(uuid(7))
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
}
