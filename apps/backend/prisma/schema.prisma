generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id           String       @id @default(uuid(7))
  name         String
  slug         String       @unique
  mtSubdomain  String
  clientId     String
  clientSecret String?
  createdAt    DateTime     @default(now())
  banners      Banner[]
  categories   Category[]
  products     Product[]
  sessions     Session[]
  tenantBrand  TenantBrand?
  users        User[]
}

model Product {
  id          String            @id @default(uuid(7))
  tenantId    String
  description String?
  mtTitle     String?
  mtDescription String?
  visible     Boolean           @default(true)
  sortOrder   Int?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  mtProductId String
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  categories  ProductCategory[]
  images      ProductImage[]
  variants    ProductVariant[]

  @@unique([tenantId, mtProductId])
  @@index([tenantId])
  @@index([mtProductId])
}

model Session {
  id           String   @id @default(uuid(7))
  userId       String
  tenantId     String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  role         String
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([userId])
}

model Banner {
  id           String    @id @default(uuid(7))
  tenantId     String
  title        String?
  productClass String?
  expiresAt    DateTime?
  sortOrder    Int?
  visible      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  filename     String
  mimeType     String
  originalName String
  size         Int
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  tenant       Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([visible])
  @@index([categoryId])
}

model ProductVariant {
  id           String         @id @default(uuid(7))
  productId    String
  mtVariantId  String
  sku          String
  description  String?
  mtTitle      String?
  mtPrice      Decimal?       @db.Decimal(10, 2)
  mtAttributes Json?
  visible      Boolean        @default(true)
  sortOrder    Int?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  images       ProductImage[]
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, mtVariantId])
  @@index([productId])
  @@index([mtVariantId])
  @@index([sku])
}

model ProductImage {
  id           String          @id @default(uuid(7))
  productId    String?
  variantId    String?
  filename     String
  originalName String
  mimeType     String
  size         Int
  isFeatured   Boolean         @default(false)
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  product      Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@index([isFeatured])
}

model User {
  id                  String   @id
  tenantId            String
  email               String?
  name                String?
  role                String
  preferredLocationId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  tenant              Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([role])
}

model TenantBrand {
  id                       String       @id @default(uuid())
  tenantId                 String       @unique
  brandName                String?
  primaryColor             String?
  secondaryColor           String?
  logoLightUrl             String?
  logoDarkUrl              String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  primaryForegroundColor   String?
  secondaryForegroundColor String?
  storeName                String       @default("")
  storeDescription         String?
  contactEmail             String       @default("")
  defaultLocationId        String?
  storeHours               StoreHours[]
  tenant                   Tenant       @relation(fields: [tenantId], references: [id])
}

model Category {
  id          String            @id @default(uuid(7))
  tenantId    String
  name        String
  description String?
  slug        String
  imageUrl    String?
  sortOrder   Int?
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  banners     Banner[]
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  products    ProductCategory[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([sortOrder])
  @@index([deletedAt])
}

model ProductCategory {
  id         String   @id @default(uuid(7))
  productId  String
  categoryId String
  createdAt  DateTime @default(now())
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
}

model StoreHours {
  id            String      @id @default(uuid())
  tenantBrandId String
  dayOfWeek     String
  openTime      String?
  closeTime     String?
  isOpen        Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  TenantBrand   TenantBrand @relation(fields: [tenantBrandId], references: [id], onDelete: Cascade)

  @@unique([tenantBrandId, dayOfWeek])
  @@index([tenantBrandId])
}
