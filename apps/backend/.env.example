# Backend Environment Variables - Example
# Copy this file to .env and fill in your values

# ============================================================================
# ENVIRONMENT
# ============================================================================
NODE_ENV=development
PORT=4000

# ============================================================================
# DATABASE
# ============================================================================
# DEVELOPMENT: Use Neon PostgreSQL
#   Get URL: https://console.neon.tech/ → Copy connection string
# PRODUCTION: Use DigitalOcean Managed Database or similar
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ============================================================================
# SESSION / COOKIE SECURITY
# ============================================================================
# DEVELOPMENT: Can use any string (e.g., "dev-secret")
# PRODUCTION: Use strong random string (min 32 chars)
#   Generate: openssl rand -base64 32
COOKIE_SECRET=dev-secret-change-in-production

COOKIE_NAME=sync5_session
SESSION_MAX_AGE_SECONDS=86400

# ============================================================================
# OAUTH REDIRECT URI
# ============================================================================
# This URL is shared across all tenants and all environments
# DEVELOPMENT: http://localhost:3000/auth/callback
# STAGING: https://staging.yourdomain.com/auth/callback
# PRODUCTION: https://yourdomain.com/auth/callback
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# ============================================================================
# MARIANATEK MULTI-TENANT SETUP
# ============================================================================
# NOTE: Marianatek API URLs are constructed dynamically per tenant at runtime.
# Client credentials (mtClientId, mtClientSecret) are stored in the Tenant table.
#
# Each tenant has:
#   - mtSubdomain: e.g., "studio1" (becomes studio1.marianatek.com)
#   - mtClientId: OAuth client ID from Marianatek dashboard
#   - mtClientSecret: OAuth client secret (if applicable)
#
# URL Format at runtime:
#   https://${tenant.mtSubdomain}.marianatek.com
#
# DO NOT hardcode or override these URLs in .env.
# The helpers in config.ts (getMTBaseURL, getMTOAuthURLs, getMTApiURLs) 
# build them dynamically from tenant.mtSubdomain.
